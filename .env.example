# Copy to .env (never versioned), then fill in.
DOMAIN=puzzle.example.org
# Password hash: docker compose run --rm puzzle python3 -m server.auth hash
PUZZLE_PASSWORD_HASH=
# Host directory of the journal, photos, sessions and backups (owned by PUZZLE_UID)
PUZZLE_DATA_VOLUME=/srv/puzzle
PUZZLE_UID=1000
PUZZLE_GID=1000
TZ=Europe/Paris
