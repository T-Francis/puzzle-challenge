# Images of the project. Everything runs in containers (no Python on the host).
#   base     : Debian 12 + the scientific stack from Debian packages
#   pipeline : base + SVG rasterizer + jpegtran (lossless rotation of new photos); runs src/pipeline.py on the
#              repository mounted at /work
#   server   : base + web stack; the live workshop and the public demo
FROM debian:bookworm-slim AS base
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LANG=C.UTF-8
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-numpy python3-scipy python3-opencv python3-skimage python3-pil \
 && rm -rf /var/lib/apt/lists/*

FROM base AS pipeline
RUN apt-get update \
 && apt-get install -y --no-install-recommends librsvg2-bin libjpeg-turbo-progs \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
ENTRYPOINT ["python3", "-I", "src/pipeline.py"]

FROM base AS server
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3-starlette python3-uvicorn python3-cbor2 python3-cryptography python3-httpx tzdata \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# model (catalogs, board, parameters): generated by the pipeline ("all" then "model"), frozen in the image
COPY photos/manifest.json photos/manifest.json
COPY data/pieces.json data/pieces_raw.npz data/board.json data/board_sockets.npz data/params.json data/
COPY data/model/ data/model/
COPY src/ src/
COPY server/ server/
COPY web/ web/
COPY demo/ demo/
COPY tests/ tests/
RUN python3 -m server.build_web /app/server/web-dist
ENV PUZZLE_MODEL=/app/data PUZZLE_WEB=/app/server/web-dist PUZZLE_STORE=/data TZ=Europe/Paris
USER 1000:1000
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=4)"
CMD ["python3", "-m", "uvicorn", "server.app:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log", "--proxy-headers", "--forwarded-allow-ips", "*"]
